---
import type { ProjectEntry } from "@/data/projects";
import { getAssetPath } from "@/utils/withBase";

type Props = ProjectEntry;

const {
  title,
  description,
  image,
  imageAlt,
  tags,
  metric,
  context,
  links = [],
} = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) =>
  isExternal(href) || href.startsWith("#") || href.startsWith("mailto:")
    ? href
    : getAssetPath(href);
---

<article
  class="border-border grid gap-6 border-b py-10 first:pt-0 last:border-b-0 last:pb-0 sm:grid-cols-[240px_minmax(0,1fr)] sm:items-center sm:gap-8"
>
  <img
    src={getAssetPath(image)}
    alt={imageAlt}
    width="640"
    height="400"
    loading="lazy"
    decoding="async"
    class="border-border aspect-[8/5] w-full rounded-xl border object-cover"
  />

  <div class="min-w-0">
    <h3 class="text-xl leading-7 font-semibold">{title}</h3>

    <p class="mt-2 leading-7 opacity-90">{description}</p>

    <ul
      class="mt-4 flex flex-wrap gap-2"
      aria-label={`Technologies for ${title}`}
    >
      {
        tags.map(tag => (
          <li class="border-border rounded-full border px-2.5 py-1 text-xs opacity-80">
            {tag}
          </li>
        ))
      }
    </ul>

    {
      (metric || context) && (
        <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          {metric && <p class="text-accent font-semibold">{metric}</p>}
          {context && <p class="text-xs opacity-65">{context}</p>}
        </div>
      )
    }

    {
      links.length > 0 && (
        <nav
          class="mt-4 flex flex-wrap items-center gap-x-2"
          aria-label={`Links for ${title}`}
        >
          {links.map((link, index) => (
            <Fragment>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a
                href={resolveHref(link.url)}
                target={isExternal(link.url) ? "_blank" : undefined}
                rel={isExternal(link.url) ? "noopener noreferrer" : undefined}
                class="text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
              >
                {link.label}
              </a>
            </Fragment>
          ))}
        </nav>
      )
    }
  </div>
</article>
