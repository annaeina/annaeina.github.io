---
import { getRelativeLocaleUrl } from "astro:i18n";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ResearchItem from "@/components/ResearchItem.astro";

import { research } from "@/data/research";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const homeResearch = research.slice(0, 3);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- Hero -->
    <section class="border-border border-b py-12">
      <div
        class="flex flex-col-reverse gap-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="max-w-2xl">
          <h1 class="mb-5 text-4xl font-bold sm:text-5xl">Hi, I'm Linglin.</h1>

          <p class="leading-7">
            I am a third-year undergraduate student in Computer Science at
            SUSTech. My research focuses on{" "}
            <strong>multimodal information retrieval</strong> and{" "}
            <strong>efficient vision-language systems</strong>, particularly{
              " "
            }
            <strong>visual document retrieval</strong> and representation compression,
            under the supervision of{" "}
            <a
              href="https://xuemengsong.github.io/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent whitespace-nowrap underline decoration-dashed underline-offset-4"
            >
              <em>Prof. Xuemeng Song.</em>
            </a>
          </p>

          <p class="mt-4 leading-7">
            I am also interested in exploring LLM agents, multimodal reasoning,
            spatial intelligence, and high-performance AI systems.
          </p>

          <p class="mt-5 text-sm tracking-wide opacity-75">
            Beyond research: Badminton 🏸 · Guzheng 🪕 · Travel ⛰️
          </p>

          <p class="mt-4 leading-7 opacity-80">
            I'm still learning, growing, and exploring the things that excite
            me. Feel free to reach out and say hi!
          </p>

          {
            socials.length > 0 && (
              <div class="mt-6 flex items-center gap-2">
                <span class="mr-2">Elsewhere:</span>
                <Socials />
              </div>
            )
          }
        </div>

        <img
          src="/profile.jpg"
          alt="Linglin He"
          class="h-52 w-40 shrink-0 rounded-2xl object-cover object-top sm:h-56 sm:w-44"
        />
      </div>
    </section>

    <!-- Education -->
    <section class="border-border border-b py-10">
      <h2 class="mb-6 text-2xl font-semibold">Education</h2>

      <div>
        <div class="flex flex-col justify-between gap-1 sm:flex-row">
          <div>
            <h3 class="text-lg font-semibold">
              Southern University of Science and Technology (SUSTech)
            </h3>

            <p class="mt-1">B.S. in Computer Science · Turing Class</p>
          </div>

          <span class="text-sm opacity-70"> Shenzhen, China </span>
        </div>
      </div>
    </section>

    <!-- Selected Research -->
    <section class="py-10">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-semibold">Selected Research</h2>

        <a
          href={getRelativeLocaleUrl(locale, "research")}
          class="text-accent whitespace-nowrap underline decoration-dashed underline-offset-4 hover:decoration-solid"
        >
          All research →
        </a>
      </div>

      {homeResearch.map(item => <ResearchItem {...item} />)}
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
