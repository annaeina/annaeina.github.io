---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectItem from "@/components/ProjectItem.astro";
import { projects } from "@/data/projects";
---

<Layout
  title="Projects | Linglin He"
  description="Selected machine learning, systems, and high-performance computing projects by Linglin He."
>
  <Header />

  <main id="main-content" class="app-layout py-12">
    <h1 class="mb-8 text-4xl font-bold">Projects</h1>

    <p class="mb-12 text-lg leading-8 opacity-80">
      Things I've built, explored, and optimized.
    </p>

    <section>
      <h2 class="mb-8 text-2xl font-semibold">Featured Projects</h2>

      <div>{projects.map(project => <ProjectItem {...project} />)}</div>
    </section>
  </main>

  <Footer />
</Layout>
